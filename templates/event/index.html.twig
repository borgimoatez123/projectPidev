{% extends 'base.html.twig' %}

{% block title %}Events - MeetNTrip
{% endblock %}

{% block body %}
	<!-- Page Header Start -->
	<div class="container-fluid page-header py-5 mb-5 wow fadeIn" data-wow-delay="0.1s">
		<div class="container text-center py-5">
			<h1 class="display-3 text-white mb-4 animated slideInDown">Events</h1>
			<nav aria-label="breadcrumb animated slideInDown">
				<ol class="breadcrumb justify-content-center mb-0">
					<li class="breadcrumb-item">
						<a href="{{ path('app_home') }}">Home</a>
					</li>
					<li class="breadcrumb-item text-primary" aria-current="page">Events</li>
				</ol>
			</nav>
		</div>
	</div>
	<!-- Page Header End -->

	<!-- Events Start -->
	<div class="container-xxl py-5">
		<div class="container">
			<div
				class="row g-4">
				<!-- Event 1 -->
				<div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.1s">
					<div class="service-item rounded overflow-hidden">
						<div class="position-relative p-4">
							<div class="service-icon">
								<i class="fas fa-calendar-alt fa-2x"></i>
							</div>
							<h4 class="mb-3">Corporate Conference</h4>
							<p>Professional business conferences and corporate events management services.</p>
							<a class="small fw-medium" href="#">Read More<i class="fa fa-arrow-right ms-2"></i>
							</a>
						</div>
					</div>
				</div>
				<!-- Event 2 -->
				<div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.3s">
					<div class="service-item rounded overflow-hidden">
						<div class="position-relative p-4">
							<div class="service-icon">
								<i class="fas fa-users fa-2x"></i>
							</div>
							<h4 class="mb-3">Team Building</h4>
							<p>Organize engaging team building activities and corporate retreats.</p>
							<a class="small fw-medium" href="#">Read More<i class="fa fa-arrow-right ms-2"></i>
							</a>
						</div>
					</div>
				</div>
				<!-- Event 3 -->
				<div class="col-lg-4 col-md-6 wow fadeInUp" data-wow-delay="0.5s">
					<div class="service-item rounded overflow-hidden">
						<div class="position-relative p-4">
							<div class="service-icon">
								<i class="fas fa-chalkboard-teacher fa-2x"></i>
							</div>
							<h4 class="mb-3">Training Workshop</h4>
							<p>Professional development workshops and training sessions.</p>
							<a class="small fw-medium" href="#">Read More<i class="fa fa-arrow-right ms-2"></i>
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
	<!-- Events End -->
{% endblock %}
