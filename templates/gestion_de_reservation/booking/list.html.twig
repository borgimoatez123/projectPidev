{% extends 'base.html.twig' %}

{% block title %}Bookings List
{% endblock %}

{% block body %}
	<h1>Bookings List</h1>

	<h2>Pending Bookings</h2>
	{% if pendingBookings is not empty %}
		<table class="table">
			<thead>
				<tr>
					<th>ID</th>
					<th>Booking Date</th>
					<th>User</th>
					<th>Total Price</th>
					<th>Status</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				{% for booking in pendingBookings %}
					<tr>
						<td>{{ booking.id }}</td>
						<td>{{ booking.bookingDate|date('Y-m-d H:i:s') }}</td>
						<td>{{ booking.userEmail }}</td>
						<td>{{ booking.priceTotal }}</td>
						<td>{{ booking.status }}</td>
						<td>
							<form action="{{ path('app_booking_delete', {'id': booking.id}) }}" method="post" onsubmit="return confirm('Are you sure you want to delete this booking?');">
								<input type="hidden" name="_method" value="DELETE">
								<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ booking.id) }}">
								<button type="submit" class="btn btn-danger">Delete</button>
							</form>
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	{% else %}
		<p>No pending bookings found.</p>
	{% endif %}

	<h2>Confirmed Bookings</h2>
	{% if confirmedBookings is not empty %}
		<table class="table">
			<thead>
				<tr>
					<th>ID</th>
					<th>Booking Date</th>
					<th>User</th>
					<th>Total Price</th>
					<th>Status</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				{% for booking in confirmedBookings %}
					<tr>
						<td>{{ booking.id }}</td>
						<td>{{ booking.bookingDate|date('Y-m-d H:i:s') }}</td>
						<td>{{ booking.userEmail }}</td>
						<td>{{ booking.priceTotal }}</td>
						<td>{{ booking.status }}</td>
						<td>
							<form action="{{ path('app_booking_delete', {'id': booking.id}) }}" method="post" onsubmit="return confirm('Are you sure you want to delete this booking?');">
								<input type="hidden" name="_method" value="DELETE">
								<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ booking.id) }}">
								<button type="submit" class="btn btn-danger">Delete</button>
							</form>
						</td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	{% else %}
		<p>No confirmed bookings found.</p>
	{% endif %}
{% endblock %}
